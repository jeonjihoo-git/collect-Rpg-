<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity 프로젝트의 순수 C# 코어(Assets/Lumina/Core)와 공용 NUnit 테스트(Assets/Lumina/Tests/EditMode)를
       Unity 없이 컴파일·실행한다. Unity Test Runner 에서도 같은 테스트 파일을 그대로 사용한다. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Lumina.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Lumina/Core/**/*.cs" />
    <Compile Include="$(RepoRoot)Assets/Lumina/Tests/EditMode/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
  </ItemGroup>
</Project>
