<Project Sdk="Microsoft.NET.Sdk">
  <!-- 헤드리스 검증 도구: Unity 없이 코어로 전체 흐름(로비→스테이지→편성→전투→결과→저장)을 실행하고,
       무기별 효과음 WAV 미리듣기와 처치 시간(TTK) 표를 출력한다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Lumina.Sim</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepoRoot)Assets/Lumina/Core/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
